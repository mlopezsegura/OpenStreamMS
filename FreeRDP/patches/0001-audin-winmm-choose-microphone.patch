+
+/* Endpoint id of a waveIn device, e.g. "{0.0.1.00000000}.{guid}", as UTF-8. Caller frees. */
+static char* audin_winmm_endpoint_id(UINT index)
+{
+	ULONG bytes = 0;
+	if (waveInMessage((HWAVEIN)(UINT_PTR)index, DRV_QUERYFUNCTIONINSTANCEIDSIZE, (DWORD_PTR)&bytes,
+	                  0) != MMSYSERR_NOERROR ||
+	    bytes == 0)
+		return nullptr;
+
+	WCHAR* wid = calloc(bytes + sizeof(WCHAR), 1);
+	if (!wid)
+		return nullptr;
+
+	char* id = nullptr;
+	if (waveInMessage((HWAVEIN)(UINT_PTR)index, DRV_QUERYFUNCTIONINSTANCEID, (DWORD_PTR)wid, bytes) ==
+	    MMSYSERR_NOERROR)
+		id = ConvertWCharToUtf8Alloc(wid, nullptr);
+	free(wid);
+	return id;
+}
+
+/**
+ * Resolves the /microphone dev: option to a waveIn index. Accepts the Windows endpoint id
+ * (unambiguous, what OpenStreamMS passes) or the WAVEINCAPS name. "default" or no match
+ * keep WAVE_MAPPER with the default communication device, as before.
+ */
+static void audin_winmm_resolve_device(AudinWinmmDevice* winmm)
+{
+	winmm->device_id = WAVE_MAPPER;
+	if (!winmm->device_name || strcmp(winmm->device_name, "default") == 0)
+		return;
+
+	const UINT count = waveInGetNumDevs();
+	for (UINT i = 0; i < count; i++)
+	{
+		char* id = audin_winmm_endpoint_id(i);
+		const BOOL match = id && _stricmp(id, winmm->device_name) == 0;
+		free(id);
+		if (match)
+		{
+			winmm->device_id = i;
+			return;
+		}
+	}
+
+	for (UINT i = 0; i < count; i++)
+	{
+		WAVEINCAPSA caps = WINPR_C_ARRAY_INIT;
+		if (waveInGetDevCapsA(i, &caps, sizeof(caps)) == MMSYSERR_NOERROR &&
+		    strcmp(caps.szPname, winmm->device_name) == 0)
+		{
+			winmm->device_id = i;
+			return;
+		}
+	}
+
+	WLog_Print(winmm->log, WLOG_WARN,
+	           "microphone '%s' not found, using the default communication device",
+	           winmm->device_name);
+}
+
+/* With WAVE_MAPPER the default communication device; with a chosen device, that one. */
+static DWORD audin_winmm_open_flags(const AudinWinmmDevice* winmm)
+{
+	return winmm->device_id == WAVE_MAPPER ? WAVE_MAPPED_DEFAULT_COMMUNICATION_DEVICE : 0;
+}
